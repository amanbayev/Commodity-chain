{
  "name": "commodity-chain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Regulated tokenized commodity exchange monorepo",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "contract:lint": "redocly lint packages/contracts/openapi.yaml --config redocly.yaml",
    "db:migrate": "dbmate --migrations-dir ops/migrations up",
    "db:rollback": "dbmate --migrations-dir ops/migrations down",
    "db:status": "dbmate --migrations-dir ops/migrations status",
    "format": "prettier --write .",
    "gen:api": "pnpm --filter @commodity-chain/web gen:api",
    "gen:api:check": "pnpm gen:api && git diff --exit-code -- apps/web/src/api/generated/schema.ts",
    "lint": "eslint . && prettier --check .",
    "migrate:check": "dbmate --migrations-dir ops/migrations up",
    "reconcile:supply": "node --experimental-strip-types ops/reconcile-supply.ts",
    "reconcile:settlements": "node --experimental-strip-types ops/reconcile-settlements.ts",
    "redemption:timeouts": "node --experimental-strip-types ops/process-redemption-timeouts.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.46.1",
    "@types/node": "22.19.1",
    "dbmate": "2.35.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
