{
  "name": "@commodity-chain/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "dev": "vite",
    "gen:api": "openapi-typescript ../../packages/contracts/openapi.yaml -o src/api/generated/schema.ts",
    "test": "vitest run --passWithNoTests src",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "vite": "8.2.1"
  }
}
