{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity-chain.local/schemas/events/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "nonce", "eventType", "schemaVersion", "occurredAt", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "nonce": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "A non-negative integer serialized as a decimal string."
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
